# Copy this file to `.env` and adjust values as needed.
# Every value here has a safe default in config/settings.py — you only
# need to set what you want to override.

# ---- General ----
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FILE=app.log

# ---- YOLO / Detection (Phase 3) ----
YOLO_MODEL_PATH=models/yolo/yolov8n.pt
YOLO_DEVICE=cpu
YOLO_CONFIDENCE_THRESHOLD=0.4
YOLO_IOU_THRESHOLD=0.45
YOLO_TARGET_CLASSES=["car","motorcycle","bus","truck","bicycle","person"]

# ---- Video input (Phase 2) ----
VIDEO_SOURCE_TYPE=file
VIDEO_SOURCE_PATH=data/input/videos/Road Safety_ What are the causes of this accident __ Cyberabad Traffic Police.mp4
WEBCAM_INDEX=0
FRAME_SKIP=0
RTSP_RECONNECT_ATTEMPTS=5
RTSP_RECONNECT_DELAY_SEC=2.0
RTSP_READ_FAILURE_LIMIT=10

# ---- Tracking (Phase 4) ----
TRACKER_MAX_MISSED_FRAMES=30
TRACKER_MIN_HITS=3
TRACKER_IOU_THRESHOLD=0.8
TRACKER_TRACK_HIGH_THRESH=0.5
TRACKER_TRACK_LOW_THRESH=0.1
TRACKER_NEW_TRACK_THRESH=0.6
TRACKER_FUSE_SCORE=True
TRACK_HISTORY_LENGTH=30

# ---- Collision / accident (Phase 6-7) ----
# Fine-grained thresholds for these live entirely in config/thresholds.yaml
# (collision: and accident: sections) — not here. See that file to tune
# spatial/motion/accident-scoring behavior.

# ---- Location (Phase 10) ----
DEFAULT_CAMERA_ID=CAM-001
LOCATION_MODE=fixed

# ---- Database (Phase 12) ----
DATABASE_URL=sqlite:///data/database/accidents.db

# ---- Backend / API (Phase 11) ----
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=["*"]

# ---- Alerts (Phase 13) — never put real emergency-service credentials here ----
ALERT_DESTINATIONS=["console"]
WEBHOOK_ALERT_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=[]
